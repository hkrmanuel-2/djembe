# Supabase (required - public keys, safe for client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Suno API (server-side only - do NOT prefix with VITE_)
SUNO_API_KEY=your-suno-api-key

# MVSEP API (server-side only)
MVSEP_API_KEY=your-mvsep-api-key

# Cloudinary (server-side only)
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# CORS (set to your production URL on Vercel)
ALLOWED_ORIGIN=http://localhost:5173
